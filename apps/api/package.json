{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "seed": "tsx --env-file=../../.env prisma/seed.ts",
    "content:powerfit": "tsx --env-file=../../.env prisma/powerfit-content.ts",
    "backfill:attendance-codes": "tsx --env-file=../../.env prisma/backfill-attendance-codes.ts",
    "backfill:membership-missions": "tsx --env-file=../../.env prisma/backfill-membership-missions.ts",
    "qa:journey": "tsx --env-file=../../.env prisma/qa-journey.ts",
    "postinstall": "prisma generate",
    "test": "dotenv -e ../../.env -- vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.1.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
