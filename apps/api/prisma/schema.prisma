generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  STAFF
  MEMBER
}

enum NoticeKind {
  D7
  D3
  D0
  EXPIRED
  BROADCAST
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String
  role         Role
  name         String
  tokenVersion Int                @default(0)
  member       Member?
  pushSubs     PushSubscription[]
  createdAt    DateTime           @default(now())
}

/// Datos personales mínimos (Ley 29733): nombre, teléfono, correo opcional y fecha de consentimiento.
model Member {
  id          String       @id @default(cuid())
  fullName    String
  phone       String
  email       String?
  consentAt   DateTime
  userId      String?      @unique
  user        User?        @relation(fields: [userId], references: [id])
  memberships Membership[]
  notices     Notice[]
  createdAt   DateTime     @default(now())
}

model Plan {
  id           String       @id @default(cuid())
  name         String       @unique
  durationDays Int
  /// Precio referencial (solo informativo, sin cobro en línea).
  price        Decimal      @db.Decimal(8, 2)
  active       Boolean      @default(true)
  memberships  Membership[]
}

model Membership {
  id          String      @id @default(cuid())
  memberId    String
  member      Member      @relation(fields: [memberId], references: [id])
  planId      String
  plan        Plan        @relation(fields: [planId], references: [id])
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  cancelledAt DateTime?
  /// Membresía a la que renueva. onTime = registrada antes o el mismo día del vencimiento previo.
  previousId  String?     @unique
  previous    Membership? @relation("Renewal", fields: [previousId], references: [id])
  next        Membership? @relation("Renewal")
  onTime      Boolean?
  createdAt   DateTime    @default(now())
  notices     Notice[]

  @@index([endDate])
}

model Notice {
  id           String      @id @default(cuid())
  memberId     String
  member       Member      @relation(fields: [memberId], references: [id])
  membershipId String?
  membership   Membership? @relation(fields: [membershipId], references: [id])
  broadcastId  String?
  broadcast    Broadcast?  @relation(fields: [broadcastId], references: [id])
  kind         NoticeKind
  title        String
  body         String
  createdAt    DateTime    @default(now())
  readAt       DateTime?
  pushedAt     DateTime?
  waSentAt     DateTime?

  @@unique([membershipId, kind])
  @@index([memberId, createdAt])
}

model Broadcast {
  id        String   @id @default(cuid())
  title     String
  body      String
  segment   Json
  sentCount Int
  createdAt DateTime @default(now())
  notices   Notice[]
}

model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh   String
  auth     String
}

/// Registro idempotente de tareas programadas: una fila por tarea y día.
model JobRun {
  id         String    @id @default(cuid())
  name       String
  runDate    DateTime  @db.Date
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  result     Json?

  @@unique([name, runDate])
}

model ManualHours {
  id        String   @id @default(cuid())
  weekStart DateTime @db.Date @unique
  hours     Decimal  @db.Decimal(5, 1)
}

/// Línea base de indicadores (diagnóstico inicial).
model Baseline {
  key   String @id
  value Float
  label String
}
